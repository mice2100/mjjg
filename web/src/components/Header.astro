---
import { SITE } from '../data/site.js';
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="#14523d" />
        <circle cx="32" cy="32" r="17" fill="none" stroke="#c8952b" stroke-width="5" />
        <circle cx="32" cy="32" r="6" fill="#c8952b" />
      </svg>
      <span>
        <span class="brand-name">Jade Garden</span>
        <span class="brand-sub">Moose Jaw · Since 2012</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <a class="link" href="/order/">Menu</a>
      <a class="link" href="/#about">Our story</a>
      <a class="link" href="/gallery/">Gallery</a>
      <a class="link" href="/#visit">Hours &amp; location</a>
      <div class="header-actions">
        <!-- Filled by scripts/account.js; stays empty when no sign-in provider is configured. -->
        <div data-account-slot></div>
        <a class="btn btn-primary" href="/order/">Order online</a>
      </div>
    </nav>
  </div>
</header>
