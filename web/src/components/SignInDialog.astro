---
// Customer sign-in. Only providers configured in the Worker (/api/config) are shown.
---
<dialog class="sheet" id="signin-dialog" aria-labelledby="signin-title">
  <button class="sheet-close" type="button" data-close aria-label="Close">×</button>
  <div class="sheet-body">
    <div>
      <p class="eyebrow">Jade Garden account</p>
      <h2 id="signin-title" style="font-size:26px;margin-top:4px">Sign in or create an account</h2>
      <p class="lede" style="margin-top:8px;font-size:15px">
        Save your details for faster checkout and keep track of your orders. No password needed.
      </p>
    </div>
    <div class="signin-providers">
      <div data-provider="google" hidden></div>
      <button type="button" class="provider-btn provider-apple" data-provider="apple" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.37 12.78c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.28-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.78.74 2.99.72 1.24-.02 2.02-1.12 2.77-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.39-.92-2.4-3.69zM14.1 6.03c.63-.77 1.06-1.83.94-2.9-.91.04-2.02.61-2.67 1.37-.58.67-1.1 1.76-.96 2.8 1.02.08 2.06-.52 2.69-1.27z"/></svg>
        Continue with Apple
      </button>
      <button type="button" class="provider-btn provider-facebook" data-provider="facebook" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"/></svg>
        Continue with Facebook
      </button>
    </div>
    <p class="signin-error" role="alert" hidden></p>
    <p class="hint" style="font-size:12px;color:var(--muted)">
      We store your name and email to manage your account. We only send offers if you opt in.
      See our <a href="/privacy/">privacy policy</a>.
    </p>
  </div>
</dialog>

<script>
  import { initAccount } from '../scripts/account.js';
  initAccount();
</script>

<style>
  .signin-providers { display: grid; gap: 10px; }
  .provider-btn {
    display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; width: 100%;
    border-radius: 999px; border: 1.5px solid var(--line); font-weight: 700; cursor: pointer; background: var(--paper);
  }
  .provider-apple { background: #000; color: #fff; border-color: #000; }
  .provider-facebook { background: #1877f2; color: #fff; border-color: #1877f2; }
  [data-provider='google'] { display: flex; justify-content: center; min-height: 44px; }
  [data-provider='google'][hidden] { display: none; }
  .signin-error { color: var(--lacquer); font-size: 14px; }
</style>
