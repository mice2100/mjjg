---
// Photo gallery. Photos and alt text come from src/data/gallery.json
// (generated by tools/import_old_site_images.py; edit SITE_PHOTOS there to change the set).
import Base from '../layouts/Base.astro';
import { GALLERY } from '../data/site.js';

const GROUPS = [
  { id: 'all', label: 'All' },
  { id: 'food', label: 'Food' },
  { id: 'room', label: 'Dining room' },
  { id: 'buffet', label: 'Buffet' },
];
// Food first, then the room, then the buffet.
const order = { food: 0, room: 1, buffet: 2 };
const photos = [...GALLERY].sort((a, b) => order[a.group] - order[b.group]);
---
<Base title="Gallery" description="Photos of Jade Garden's food, dining room and daily buffet in downtown Moose Jaw.">
  <main class="container section gallery-page">
    <p class="eyebrow">Gallery</p>
    <h1 class="section-title">Food, room &amp; buffet</h1>
    <p class="lede">Everything here was photographed at Jade Garden, 471 Main St N.</p>

    <div class="g-tabs" role="tablist" aria-label="Filter photos">
      {GROUPS.map((g, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-group={g.id}>{g.label}</button>
      ))}
    </div>

    <ul class="g-grid">
      {photos.map((p) => (
        <li id={p.slug} data-group={p.group}>
          <button type="button" class="g-item" data-full={p.src} data-alt={p.alt} aria-label={`Open photo: ${p.alt}`}>
            <img src={p.thumb} alt={p.alt} loading="lazy" width="640" height={Math.round((640 * p.height) / p.width)} />
          </button>
        </li>
      ))}
    </ul>

    <dialog class="lightbox" aria-label="Photo viewer">
      <button type="button" class="lb-close" aria-label="Close">×</button>
      <button type="button" class="lb-nav lb-prev" aria-label="Previous photo">‹</button>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
      <button type="button" class="lb-nav lb-next" aria-label="Next photo">›</button>
    </dialog>

    <p class="g-cta"><a class="btn btn-primary" href="/order/">Order online</a></p>
  </main>
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.g-tabs button')];
  const items = [...document.querySelectorAll<HTMLLIElement>('.g-grid li')];
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;
  let current = 0;

  const visible = () => items.filter((li) => !li.hidden);

  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      items.forEach((li) => (li.hidden = tab.dataset.group !== 'all' && li.dataset.group !== tab.dataset.group));
    })
  );

  function show(index: number) {
    const list = visible();
    current = (index + list.length) % list.length;
    const btn = list[current].querySelector<HTMLButtonElement>('.g-item')!;
    img.src = btn.dataset.full!;
    img.alt = btn.dataset.alt!;
    caption.textContent = btn.dataset.alt!;
    history.replaceState(null, '', `#${list[current].id}`);
  }

  items.forEach((li) =>
    li.querySelector('.g-item')!.addEventListener('click', () => {
      show(visible().indexOf(li));
      dialog.showModal();
    })
  );
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  dialog.addEventListener('close', () => history.replaceState(null, '', location.pathname));
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Deep link from the home page: /gallery/#slug opens that photo.
  const target = location.hash && items.findIndex((li) => `#${li.id}` === location.hash);
  if (typeof target === 'number' && target >= 0) {
    show(target);
    dialog.showModal();
  }
</script>

<style>
  .gallery-page { display: grid; gap: 8px; }
  .g-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 8px; }
  .g-tabs button {
    min-height: 40px; padding: 6px 16px; border-radius: 999px; border: 1px solid var(--line);
    background: var(--paper); font-weight: 600; cursor: pointer;
  }
  .g-tabs button[aria-selected='true'] { background: var(--jade-800); border-color: var(--jade-800); color: #fff; }
  .g-grid { list-style: none; padding: 0; margin: 12px 0 0; columns: 3 280px; column-gap: 12px; }
  .g-grid li { break-inside: avoid; margin-bottom: 12px; }
  .g-grid li[hidden] { display: none; }
  .g-item { display: block; width: 100%; padding: 0; border: none; background: none; cursor: zoom-in; border-radius: var(--radius); overflow: hidden; }
  .g-item img { width: 100%; height: auto; transition: transform 0.3s; }
  .g-item:hover img { transform: scale(1.03); }
  .g-cta { margin-top: 24px; }

  .lightbox {
    border: none; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh;
    display: none; align-items: center; justify-content: center;
  }
  .lightbox[open] { display: flex; }
  .lightbox::backdrop { background: rgb(10 20 16 / 0.92); }
  .lightbox figure { margin: 0; display: grid; gap: 10px; justify-items: center; max-width: min(1200px, 88vw); }
  .lightbox img { max-height: 80vh; width: auto; border-radius: var(--radius); }
  .lightbox figcaption { color: rgb(255 255 255 / 0.85); font-size: 15px; text-align: center; }
  .lb-close, .lb-nav { position: fixed; border: none; background: rgb(255 255 255 / 0.12); color: #fff; cursor: pointer; border-radius: 999px; }
  .lb-close { top: 16px; right: 16px; width: 48px; height: 48px; font-size: 28px; }
  .lb-nav { top: 50%; transform: translateY(-50%); width: 52px; height: 52px; font-size: 34px; }
  .lb-prev { left: 12px; }
  .lb-next { right: 12px; }
  .lb-close:hover, .lb-nav:hover { background: rgb(255 255 255 / 0.25); }
</style>
