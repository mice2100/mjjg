# Production secrets for scripts/deploy.sh. Copy to .prod.vars (git-ignored); `deploy.sh setup` does it for you.
# Sent with every deploy. Empty values are skipped, so leave a line empty to keep the value already in
# Cloudflare. Only these names are accepted; public settings go in wrangler.jsonc "vars".

# Generated by `scripts/deploy.sh setup`. Changing it signs every customer out.
SESSION_SECRET=

# WooCommerce (dual-run only, AGENTS.md §11). Use the NEW read-only key (§12 item 1).
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_WEBHOOK_SECRET=

TURNSTILE_SECRET_KEY=
CLOVER_PRIVATE_KEY=
CLOVER_WEBHOOK_SECRET=
FACEBOOK_APP_SECRET=
