// One Worker serves everything:
//   * static assets built by Astro (web/dist): customer site + /staff/ (kitchen), /pos/ (phone orders), /jadmin/ (admin)
//   * /api/*  -> worker/index.js fetch handler (D1-backed API)
//   * cron    -> worker/index.js scheduled handler (expire unpaid checkouts, WooCommerce -> D1 sync)
// Secrets are NOT stored here. Set them with `wrangler secret put <NAME>` (prod)
// or in .dev.vars (local). See .dev.vars.example.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jadegarden",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jadegarden-db",
      // Replace with the real id from `wrangler d1 create jadegarden-db` before the first deploy.
      "database_id": "edeb764d-c2c7-4d4a-a616-e14f932f60a0",
      "migrations_dir": "migrations"
    }
  ],
  // Test host during dual-run. wrangler creates the DNS record and certificate on deploy.
  // workers_dev is off: Access cannot protect workers.dev, so w2 is the only public host.
  "routes": [{ "pattern": "w2.mjjadegarden.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // Every minute: expire abandoned Clover checkouts (releases their coupons) and pull
    // new/changed WooCommerce orders into D1. Keep it after the WordPress site is retired;
    // only the WooCommerce part goes away.
    "crons": ["* * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_SITE_URL": "https://mjjadegarden.com",
    "WC_STORE_URL": "https://www.mjjadegarden.com",
    "GOOGLE_CLIENT_ID": "",
    "APPLE_SERVICES_ID": "",
    "FACEBOOK_APP_ID": "",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGJcinUT1RjV_oHy",
    "ACCESS_TEAM_DOMAIN": "jadegarden.cloudflareaccess.com",
    // One Access application per role (Zero Trust > Access > Applications). Who may sign in is set there, not here.
    "ACCESS_AUD_KITCHEN": "394a0a606f9b2a80a2a1a64b9dc5ae2774f644a93586513b9a35dc16e68b536f", // /staff/ + /api/kitchen/*
    "ACCESS_AUD_POS": "99f6632a8b198d0cb3caa46f9853d45ca43531fa95f9b6c18aa75c96dec3eb2a", // /pos/ + /api/pos/*
    "ACCESS_AUD_ADMIN": "26d9392a6370744e2cf026eda1caca1406035ae4ab23e222822c61aaf81cbcee", // /jadmin/ + /api/admin/*
    // Clover Hosted Checkout. 'production' charges real cards; 'sandbox' uses apisandbox.dev.clover.com.
    // CLOVER_MERCHANT_ID is the 13-character merchant UUID (Merchant Dashboard URL), not the numeric MID.
    // Secrets: CLOVER_PRIVATE_KEY, CLOVER_WEBHOOK_SECRET. Without the key, web orders are refused in production.
    "CLOVER_ENV": "sandbox", // test cards only; switch to "production" (and the live merchant id + keys) before cutover
    "CLOVER_MERCHANT_ID": "H5D261GS53SJ1"
  },
  "observability": { "enabled": true }
}
