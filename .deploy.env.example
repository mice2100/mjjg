# Cloudflare credentials for scripts/deploy.sh. Copy to .deploy.env (git-ignored).
# Leave both empty to use `npx wrangler login` (browser sign-in) instead.
#
# API token: dash.cloudflare.com > My Profile > API Tokens > Create Token >
#   "Edit Cloudflare Workers" template, then add: Account > D1 > Edit.
#   Account Resources: only the Jade Garden account.
#   For custom domains in wrangler.jsonc "routes": Zone > Workers Routes > Edit on that zone.
CLOUDFLARE_API_TOKEN=
# Dashboard > Workers & Pages > Account details (right side) > Account ID
CLOUDFLARE_ACCOUNT_ID=

# Optional: extra URL to smoke test after deploy. The workers.dev URL and every custom domain are always tested.
# Set to https://mjjadegarden.com after cutover (AGENTS.md §11).
DEPLOY_URL=
